+
+    if (time < SLIDE_TEMPO)
+    {
+        crash_slide = SLIDE_TEMPO - time;
+        GV_DirVec2(work->control.rot.vy, SLIDE_VELOC * (SLIDE_TEMPO - time) / SLIDE_TEMPO, &work->control.step);
+        if ((time & 3) == 2)
+        {
+            sub_8004FCB8(work, &crash_slide_info, 4);
+        }
+        return;
+    }
+
+    if (work->field_9B0_pad_ptr->status & PAD_CROSS)
