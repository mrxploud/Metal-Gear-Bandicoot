+#ifdef DEV_EXE
+/* Metal Gear Bandicoot: o Aku Aku (pedido do ByteMirage). Com mascara, o golpe e absorvido: a vida volta e o Snake
+ * nao reage, so pisca (como no Warped). Com a 3a mascara, invencivel por 20 s e quem encostar no Crash cai morto
+ * (o toque da morte: um golpe em volta do corpo inteiro, com dano de matar). */
+PUNCH crash_toque_info = {{0, 0, 0}, {600, 600, 600}, {0, 0, 100}, 1024, 3};
+static int crash_aku_estava;
+
+static void CrashAkuSnake(SnaInitWork *work, TARGET *target)
+{
+    if (crash_aku_inv > 0)
+    {
+        if (!GM_CheckPlayerStatusFlag(PLAYER_INVINCIBLE) || work->field_A24_invuln_frames != 0)
+        {
+            sna_set_invuln_8004F2A0(work, 0); /* 0 = invencivel sem piscar, ate a gente tirar */
+        }
+        crash_aku_estava = 1;
+        if (GV_Time & 1)
+        {
+            /* aqui o GM_CurrentMap ainda e o do ultimo ator (o Snake so acerta no GM_ActControl, mais adiante) */
+            GM_CurrentMap = work->control.map->index;
+            DG_SetPos2(&work->control.mov, &work->control.rot);
+            sub_8004FCB8(work, &crash_toque_info, 4);
+        }
+        return;
+    }
+    if (crash_aku_estava)
+    {
+        crash_aku_estava = 0;
+        sna_clear_invuln_8004F2EC(work);
+    }
+    if ((target->damaged & 0x6) && Crash_AkuAbsorve())
+    {
+        target->vital += target->damage;
+        target->damage = 0;
+        target->damaged &= ~(0x2 | 0x4 | 0x8 | 0x80);
+        target->offset = DG_ZeroVector;
+        sna_set_invuln_8004F2A0(work, 60);
+    }
+}
+#endif
